{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VS Code File Icon Theme Specification",
  "description": "100% compliant VS Code File Icon Theme schema for UniRTM",
  "type": "object",
  "properties": {
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "src": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "format": { "type": "string", "enum": ["woff", "woff2", "ttf", "opentype"] }
              },
              "required": ["path", "format"]
            }
          },
          "weight": { "type": "string" },
          "style": { "type": "string" },
          "size": { "type": "string" }
        },
        "required": ["id", "src"]
      }
    },
    "iconDefinitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fontCharacter": { "type": "string" },
          "fontColor": { "type": "string" },
          "fontSize": { "type": "string" },
          "iconPath": { "type": "string" }
        }
      }
    },
    "file": { "type": "string" },
    "folder": { "type": "string" },
    "folderExpanded": { "type": "string" },
    "fileExtensions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "fileNames": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "languageIds": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "required": ["iconDefinitions"]
}
